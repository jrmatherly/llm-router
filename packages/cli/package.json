{
  "name": "@musistudio/claude-code-router",
  "version": "4.3.2",
  "license": "MIT",
  "description": "Local LLM Router gateway with CLI and web management UI.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jrmatherly/llm-router.git"
  },
  "bugs": {
    "url": "https://github.com/jrmatherly/llm-router/issues"
  },
  "homepage": "https://github.com/jrmatherly/llm-router#readme",
  "keywords": [
    "claude-code",
    "codex",
    "llm",
    "gateway",
    "router"
  ],
  "main": "dist/main/cli.js",
  "bin": {
    "ccr": "dist/main/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build:assets",
    "prepublishOnly": "npm --prefix ../.. run typecheck",
    "test": "node ../../build/test.mjs cli && node ../../build/run-tests.mjs cli",
    "test:integration": "node ../../build/test.mjs cli --scope integration && node ../../build/run-tests.mjs cli"
  },
  "dependencies": {
    "@the-next-ai/ai-gateway": "^1.0.21",
    "@the-next-ai/bot-gateway-sdk": "^0.1.0",
    "better-sqlite3": "^12.11.1",
    "node-forge": "^1.4.0",
    "undici": "^7.29.0"
  }
}
